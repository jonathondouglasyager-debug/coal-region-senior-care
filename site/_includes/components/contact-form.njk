<div class="form-section">
  <h2>Need Help Finding a Provider?</h2>
  <p class="page-intro">We'll connect you with the right local senior care provider for your family's needs. All inquiries are handled with care and compassion.</p>

  <form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" id="contact-form">
    <p class="sr-only">
      <label>Don't fill this out: <input name="bot-field"></label>
    </p>

    <div class="form-group">
      <label for="name">Your Name</label>
      <input type="text" id="name" name="name" required>
    </div>

    <div class="form-group">
      <label for="phone">Phone Number</label>
      <input type="tel" id="phone" name="phone">
    </div>

    <div class="form-group">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" required>
    </div>

    <div class="form-group">
      <label for="service">What do you need help with?</label>
      <select id="service" name="service">
        <option value="">Select one...</option>
        <option value="assisted-living">Assisted Living</option>
        <option value="home-health">Home Health Care</option>
        <option value="hospice">Hospice Care</option>
        <option value="nursing-home">Nursing Home / Skilled Nursing</option>
        <option value="senior-center">Senior Centers / Day Programs</option>
        <option value="support-services">Support Services (Legal, Equipment, etc.)</option>
        <option value="other">Other</option>
      </select>
    </div>

    <div class="form-group">
      <label for="message">Tell us about your situation</label>
      <textarea id="message" name="message" rows="4" placeholder="Who are you looking for care for? What kind of help do they need?"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Send Message</button>
  </form>

  <div class="form-success" id="form-success">
    <p><strong>Thank you.</strong> We've received your message and will be in touch soon.</p>
  </div>
</div>
